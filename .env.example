# ─── Google Places ───────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ─── Enrichment APIs (optional) ───────────────────────────────────────────────
APOLLO_API_KEY=
HUNTER_API_KEY=
SERPER_API_KEY=                             # serper.dev — 2,500 free searches, no card. Used to find emails for
                                             # leads with no website/social_url on file, and as a discovery source
                                             # (best-of-city places results). Falls back to a best-effort
                                             # (frequently blocked) DuckDuckGo scrape for email search if unset.
YELP_API_KEY=                               # Yelp Fusion API (developers.yelp.com) — free tier. Second discovery
                                             # source alongside Google Places in the daily discovery pipeline.
                                             # Pipeline degrades to Google-Places-only if unset.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
SERVER_URL=https://your-domain.com        # public URL (required for Twilio call webhooks)

# ─── Pipeline ─────────────────────────────────────────────────────────────────
PLACES_MAX_RESULTS=60
REQUEST_DELAY_MS=2000

# ─── Twilio (SMS + WhatsApp + Calling) ────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx            # your Twilio SMS/Voice number
TWILIO_WHATSAPP_NUMBER=+14155238886         # sandbox: +14155238886 | production: your approved WA number
TWILIO_TWIML_BIN_URL=                       # optional: TwiML Bin URL for calls (alternative to SERVER_URL webhook)
TWILIO_GATHER_WEBHOOK=/webhooks/call-response

# ─── Email (AWS SES API) ─────────────────────────────────────────────────────────
# API (HTTPS), not SMTP -- Railway blocks outbound SMTP ports on Free/Trial/Hobby
# plans, which silently hung every production send. HTTPS isn't blocked.
AWS_REGION=ap-northeast-1                   # region the SES identity was verified in
AWS_ACCESS_KEY_ID=                          # IAM access key with ses:SendEmail permission
AWS_SECRET_ACCESS_KEY=                      # shown once at key creation time -- save it immediately
                                             # (NOT the SMTP username/password -- different credential type)
SES_FROM_EMAIL=contact@stanweb.tech         # address at a verified SES *domain* identity -- sending "from" a real
                                             # mailbox provider address (e.g. @gmail.com) through SES fails DMARC
                                             # alignment and lands in spam; a verified domain avoids that
SES_FROM_NAME=StanWeb

# ─── Signature (plain text, used in every outbound email) ─────────────────────
SENDER_NAME=Chaitanya Kapre
SENDER_TITLE=Founder | StanWeb
SENDER_WEBSITE=https://stanweb.tech
CALENDLY_URL=                               # booking link -- omitted from signature if unset
WHATSAPP_SIGNATURE_NUMBER=                  # e.g. +91XXXXXXXXXX -- omitted from signature if unset
SENDER_PHONE=                               # omitted from signature if unset
SENDER_LINKEDIN=                            # optional, omitted from signature if unset

# ─── Email Sequence Engine ─────────────────────────────────────────────────────
CRON_SECRET=                                # Authorization: Bearer <this> for /outreach/email/run (admin/manual triggers)
ADMIN_USER=                                 # x-admin-user header for admin-only endpoints
ADMIN_PASS=                                 # x-admin-pass header for admin-only endpoints
EMAIL_DAILY_CAP=150                         # explicit ceiling on ALL sequence emails/day, across all senders -- normally NOT the
                                             # binding constraint: the real daily total auto-ramps as sum of each mailbox's own
                                             # warmup cap (5->10->15/mailbox over 3 weeks, see EMAIL_NEW_LEADS_PER_DAY_PER_SENDER
                                             # below); this only binds if set below that ramp total to intentionally throttle
# ─── Multi-mailbox sender rotation ─────────────────────────────────────────────
# Every address must be at the same verified SES domain identity (stanweb.tech) --
# no extra AWS setup needed per mailbox, domain verification covers all of them.
# A lead is locked to whichever mailbox sent its stage-1 email for its whole
# 4-stage sequence (reply continuity + guarantees no lead is ever double-contacted).
EMAIL_SENDER_POOL=                          # comma-separated addresses, e.g. a@stanweb.tech,b@stanweb.tech
EMAIL_SENDER_NAMES=                         # matching comma-separated first names (same order) for the signature;
                                             # falls back to SENDER_NAME's first name for any sender left unmatched
EMAIL_NEW_LEADS_PER_DAY_PER_SENDER=20       # cap on brand-new intros/day PER mailbox -- load-balanced across the pool
EMAIL_MIN_GAP_MINUTES=5                     # FLOOR on minutes between any two sends, not the target -- the actual target gap
                                             # adapts every send to (business-hours minutes left today) / (daily cap sends left),
                                             # so the ramp above is actually reachable within the send window (+ proportional jitter)
# ─── Reply watcher (decoy-opener -> reply-triggered pivot) ────────────────────
# Polls each EMAIL_SENDER_POOL mailbox's real IMAP inbox for replies to the
# stage-1/2 decoy opener, then sends the pivot/reveal email (deck attached).
EMAIL_IMAP_HOST=                            # e.g. imap.secureserver.net (GoDaddy-resold Titan uses GoDaddy's IMAP
                                             # host, NOT imap.titan.email -- check what your provider's IMAP setup
                                             # wizard auto-fills for your domain before assuming the Titan default)
EMAIL_IMAP_PORT=993
EMAIL_IMAP_PASSWORDS=                       # comma-separated, SAME ORDER as EMAIL_SENDER_POOL
REPLY_WATCHER_TICK_MINUTES=5                # how often each mailbox is polled
REPLY_WATCHER_LOOKBACK_HOURS=72             # how far back to search each poll (catches any missed cycle)
ENABLE_REPLY_WATCHER_CRON=true              # set false to disable
NOTIFY_EMAIL=                               # your own address -- gets a heads-up when a booking link is sent, or
                                             # when a post-pivot reply needs your personal follow-up. Unset = silent.

# ─── Health check (self-monitoring) ────────────────────────────────────────────
# Periodically verifies Supabase + every pool mailbox's IMAP login still work,
# and emails NOTIFY_EMAIL if anything's broken (and again once it recovers).
HEALTHCHECK_TICK_HOURS=3
ENABLE_HEALTHCHECK_CRON=true                # set false to disable
EMAIL_TICK_MINUTES=30                       # how often the internal cron checks for a due send
EMAIL_ENRICH_BATCH_SIZE=50                  # no-email leads scraped for a contact email, once/day
EMAIL_BUSINESS_HOUR_START=9                 # cron only sends between these hours (24h, CRON_TIMEZONE)
EMAIL_BUSINESS_HOUR_END=17
CRON_TIMEZONE=America/New_York
ENABLE_EMAIL_CRON=true                      # set false to disable the internal daily scheduler

# ─── Discovery Pipeline ─────────────────────────────────────────────────────────
ENABLE_DISCOVERY_CRON=true                  # set false to disable the internal daily discovery scheduler
DISCOVERY_PAIRS_PER_RUN=8                   # (niche, city) pairs searched per daily run, across all sources
DISCOVERY_ANALYSIS_BUFFER=400               # cap on with-website candidates that get the expensive live-site fetch in stage 4 (no-website candidates are exempt, always analyzed)
DISCOVERY_SCORE_BUFFER=25                   # top-scored candidates carried into email enrichment (some will fail)
DISCOVERY_TOP_N=10                          # final leads stored per run

# ─── Cold Calling ─────────────────────────────────────────────────────────────
CALL_PROVIDER=twilio                        # twilio | bland
ENABLE_CALLS=false                          # set true to enable auto cold calling
BLAND_API_KEY=                              # required only if CALL_PROVIDER=bland
BLAND_VOICE_ID=maya                         # bland.ai voice (maya, ryan, etc.)
BLAND_WEBHOOK_URL=                          # optional: receive call outcome events
DEFAULT_CALL_SCRIPT=Hello! We help local businesses get beautiful websites that bring in new clients. Press 1 if you are interested.

# ─── Outreach Campaign ────────────────────────────────────────────────────────
OUTREACH_DELAY_MS=3000                      # delay between leads (ms)
OUTREACH_BATCH_SIZE=50                      # max leads per campaign run
